   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import joblib\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "import plotly.io as pio\n",
    "\n",
    "pio.templates.default = \"plotly_white\"\n",
    "\n",
    "# Load models\n",
    "model_median = joblib.load('../ml_models/band_gap.joblib')\n",
    "model_q05 = joblib.load('../ml_models/band_gap_q05.joblib')\n",
    "model_q95 = joblib.load('../ml_models/band_gap_q95.joblib')\n",
    "\n",
    "df = pd.read_parquet('../data/enriched_perovskites.parquet').sample(50, random_state=42)\n",
    "\n",
    "# Fix categorical columns for CatBoost dynamically\n",
    "cat_features = [model_median.feature_names_[i] for i in model_median.get_cat_feature_indices()]\n",
    "for col in cat_features:\n",
    "    if col in df.columns:\n",
    "        df[col] = df[col].fillna(\"None\").astype(str)\n",
    "\n",
    "print(\"Models and sample data loaded.\")"
   ],
