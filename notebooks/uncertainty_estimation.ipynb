    "## 4. Visualizing Prediction Intervals\n",
    "We plot the predicted band gap along with its uncertainty bounds to see where the model is most confident in its understanding of the physics."
   ],
   "id": "visualization_md"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-21T09:57:45.865478Z",
     "start_time": "2026-04-21T09:57:45.786835Z"
    }
   },
   "source": [
    "features = model_median.feature_names_\n",
    "\n",
    "# Ensure ALL features are treated correctly (fix the NaN bug for cat features)\n",
    "for i, col in enumerate(features):\n",
    "    if i in model_median.get_cat_feature_indices():\n",
    "        df[col] = df[col].astype(str).replace(['nan', 'NaN', 'None', 'null'], 'None')\n",
    "    else:\n",
    "        df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0)\n",
    "\n",
    "X = df[features]\n",
    "\n",
    "preds_median = model_median.predict(X)\n",
    "preds_q05 = model_q05.predict(X)\n",
    "preds_q95 = model_q95.predict(X)\n",
    "\n",
    "results = pd.DataFrame({\n",
    "    'Composition': df['composition_long_form'],\n",
    "    'Band Gap (eV)': preds_median,\n",
    "    'Q05': preds_q05,\n",
    "    'Q95': preds_q95\n",
    "}).sort_values('Band Gap (eV)')\n",
    "\n",
    "fig = go.Figure([\n",
    "    go.Scatter(\n",
    "        name='Median Prediction',\n",
    "        x=results['Composition'],\n",
    "        y=results['Band Gap (eV)'],\n",
    "        mode='lines+markers',\n",
    "        line=dict(color='rgb(31, 119, 180)'),\n",
    "    ),\n",
    "    go.Scatter(\n",
    "        name='95th Percentile',\n",
    "        x=results['Composition'],\n",
    "        y=results['Q95'],\n",
    "        mode='lines',\n",
    "        marker=dict(color=\"#444\"),\n",
    "        line=dict(width=0),\n",
    "        showlegend=False\n",
    "    ),\n",
    "    go.Scatter(\n",
    "        name='90% Confidence Interval',\n",
    "        x=results['Composition'],\n",
    "        y=results['Q05'],\n",
    "        marker=dict(color=\"#444\"),\n",
    "        line=dict(width=0),\n",
    "        mode='lines',\n",
    "        fillcolor='rgba(68, 68, 68, 0.3)',\n",
    "        fill='tonexty',\n",
    "        showlegend=True\n",
    "    )\n",
    "])\n",
    "\n",
    "fig.update_layout(\n",
    "    title=\"Uncertainty Quantile Regression: Band Gap Confidence Intervals\",\n",
    "    title_x=0.5,\n",
    "    yaxis_title=\"Electronic Band Gap (eV)\",\n",
    "    xaxis_title=\"Material Samples (Sorted by Predictor)\",\n",
    "    hovermode=\"x\",\n",
    "    width=1000,\n",
    "    height=600\n",
    ")\n",
    "fig.show()\n",
    "\n",
    "print(\"Visualization generated with uncertainty envelopes.\")"
   ],
