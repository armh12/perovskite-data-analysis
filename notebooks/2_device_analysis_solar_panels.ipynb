     }
    }
   ],
   "execution_count": 2
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Stability Analysis: TS80m (Standardized Metric)\n",
    "We use the standardized $T_{S80m}$ value to compare the intrinsic stability of different device architectures. We use a log scale to handle the wide range of lifespans."
   ],
   "id": "stability_md"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-20T10:55:20.097973Z",
     "start_time": "2026-04-20T10:55:19.939015Z"
    }
   },
   "source": [
    "plt.figure(figsize=(10, 6), facecolor='white')\n",
    "df_clean = df_s.dropna(subset=['stability_ts80m', 'cell_architecture'])\n",
    "ax = sns.boxplot(data=df_clean, x='cell_architecture', y='stability_ts80m', palette='pastel')\n",
    "ax.set_facecolor('white')\n",
    "plt.yscale('log')\n",
    "plt.title(\"Standardized Stability (TS80m) by Device Architecture\", fontsize=14)\n",
    "plt.ylabel(\"Standardized Lifetime (Hours, Log Scale)\")\n",
    "plt.xlabel(\"Architecture Type\")\n",
    "plt.show()"
   ],
   "id": "stability_plot",
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
